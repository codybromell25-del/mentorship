# Copy to .env and fill in. Never commit .env.

# Postgres. `npm run db:local` starts a throwaway local database on 5433
# that matches these two defaults; swap for Supabase/Neon URLs in prod.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/mentorship"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/mentorship"

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Stripe (use test keys locally)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend (optional locally — emails are logged to the console when unset)
RESEND_API_KEY=""
EMAIL_FROM="Mentorship <hello@example.com>"

# Where admin notifications (new applications, payments) go
ADMIN_NOTIFY_EMAIL=""

# Google Calendar + Meet (optional). Create an OAuth client (type "Web
# application") in Google Cloud, enable the Google Calendar API, and add
# <NEXTAUTH_URL>/api/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# First-admin setup (/setup): any long random string. The page works once.
SETUP_CODE=""

# Leave unset until Kelly has approved the copy; then "true" lets Google in.
# ALLOW_INDEXING="true"
